# Telegram API Credentials
# Get these from https://my.telegram.org/apps
API_ID=your_api_id
API_HASH=your_api_hash

# Phone number for login
PHONE_NUMBER=+1234567890

# Target Telegram Channel / Group / Topic
# Can be a direct link or specific ID:
# Example: https://t.me/c/4345651366/2 or username
CHANNEL_URL=https://t.me/c/4345651366/2
GROUP_ID=-1004345651366
TOPIC_ID=2

# First message ID to download (inclusive, starts at this message)
# Example: 16 for https://t.me/c/4345651366/2/16
STARTING_MESSAGE_ID=16

# Where to save the downloaded media files
DESTINATION_FOLDER=./downloads

# Sequence Numbering: Zero-padding width (e.g. 4 for 0001, 0002...)
SEQUENCE_PADDING=4

# Media types to download: all, or comma-separated list (video, photo, document, audio)
MEDIA_TYPES=all

# Delay in seconds between downloads to avoid Telegram rate limits
DOWNLOAD_DELAY=1.5

# Maximum retry attempts per failed download
MAX_RETRIES=5
